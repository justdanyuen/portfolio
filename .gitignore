# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/node_modules.nosync  # real node_modules; the .nosync name keeps iCloud from offloading it
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/videos/SV2_demo.mp4
public/videos/SV2_pitch.mp4
public/videos/SV2_demo_stereo.mp4
public/videos/SV2_demo_youtube.mp4
PRODUCT.md

# Music page: original masters stay local; the site uses the compressed copies
# (.m4a/.mp3 demos, .webp reel covers)
/public/audio/**/*.wav
/public/images/music/reels/*.JPG
# Cal Poly gallery originals (the site uses the .webp copies)
/public/images/cal-poly/*.jpg
/public/images/cal-poly/*.JPG
/public/images/cal-poly/*.jpeg
